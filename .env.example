# The Lenny Growth Assistant — environment configuration
# Copy to `.env` and edit. Safe to run with everything below left at its
# default: the local provider requires no API key (§9, ADR-005/006 in
# architecture.md). Never commit a real .env.

# ── LLM provider toggle ─────────────────────────────────────────────────
# ollama = default, mandatory for the demo, no key required.
# anthropic = opt-in cloud provider. No silent failover between the two —
# see architecture.md ADR-005.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct

# Required only when LLM_PROVIDER=anthropic. Absent -> cloud shows
# unavailable in GET /config; the app still starts and runs on Ollama.
# ANTHROPIC_API_KEY=sk-ant-...

# Cloud model to use when LLM_PROVIDER=anthropic.
# LLM_MODEL=claude-sonnet-4-5

# ── Ollama (local, default) ─────────────────────────────────────────────
# Reached from inside Compose via the host gateway. Override if Ollama runs
# somewhere else (a remote box, a different port).
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text

# ── Database ─────────────────────────────────────────────────────────────
# Only used if you run api/ outside Compose. Inside Compose this is set by
# docker-compose.yml and does not need to be duplicated here.
# DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5432/lenny_growth_assistant

# ── Retrieval tuning ─────────────────────────────────────────────────────
# Cosine similarity floor below which the system abstains rather than
# answering on weak context (architecture.md §7, AC3). Empirically
# calibrated 2026-08-25 against the real corpus and tests/eval/questions.yaml
# (in-corpus top scores 0.7013-0.8274 vs. out-of-corpus 0.5703-0.6535) --
# see api/app/config.py's Settings.retrieval_floor for the full derivation
# and why 0.68, not the gap's exact midpoint.
RETRIEVAL_FLOOR=0.68

# How many candidates the initial cosine search pulls back before session
# boost and the relevance floor are applied. Only takes effect when a
# caller doesn't pass an explicit `k` on POST /internal/retrieve. Raise for
# recall on a larger/more diverse corpus; lower for latency.
TOP_K_DEFAULT=8

# How many ranked chunks are actually returned to the model (and eligible
# to be cited) after filtering. Bounds prompt size and max citations/turn.
RETURN_N=4

# Score bump applied to chunks from episodes already cited earlier in the
# session, so the assistant tends to stay on-topic within a conversation.
# Capped at score 1.0 so it can never fully invert a strong new-topic match.
SESSION_BOOST=0.05

# ── Internal service auth ───────────────────────────────────────────────
# Shared secret between api and agent for POST /internal/retrieve. Any
# non-empty string works for local dev; generate a real one for anything
# beyond a laptop demo.
AGENT_INTERNAL_TOKEN=dev-local-only-change-me

# ── Timeouts / resilience ───────────────────────────────────────────────
MODEL_TIMEOUT_S=60

# ── Agent extensions (root CLAUDE.md invariant #4) ──────────────────────
# Off by default. Pi's .pi/extensions/ mechanism runs arbitrary in-process
# code that can register any tool with no sandbox of its own — turning this
# on only loads extensions listed in agent/.pi/extensions/manifest.json by
# exact path + content sha256 + declared tool names; anything else present,
# or any drift from what's approved, fails startup closed rather than
# loading a subset. See agent/src/capabilities.ts.
AGENT_EXTENSIONS_ENABLED=false

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────
# Origins allowed to call api from a browser (comma-separated, exact match,
# no wildcard). The default matches web's dev server per docker-compose.yml
# (VITE_API_BASE_URL: http://localhost:8000, served at http://localhost:5173).
CORS_ORIGINS=http://localhost:5173
